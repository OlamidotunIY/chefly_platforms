{
  "name": "chefly_platforms",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "add:web": "pnpm dlx shadcn@latest add -c apps/web",
    "api:generate": "pnpm --filter @chefly/api generate",
    "build": "turbo build",
    "dev:web": "pnpm --filter @chefly/web dev",
    "dev:mobile": "pnpm --filter @chefly/mobile dev",
    "dev:mobile:go": "pnpm --filter @chefly/mobile dev:go",
    "dev:mobile:tunnel": "pnpm --filter @chefly/mobile dev:tunnel",
    "mobile:android": "pnpm --filter @chefly/mobile android",
    "mobile:ios": "pnpm --filter @chefly/mobile ios",
    "mobile:build:dev:android": "pnpm --filter @chefly/mobile build:dev:android",
    "mobile:build:dev:ios": "pnpm --filter @chefly/mobile build:dev:ios",
    "mobile:build:dev:ios-sim": "pnpm --filter @chefly/mobile build:dev:ios-sim",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.15",
    "typescript": "~6"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
