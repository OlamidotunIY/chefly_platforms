{
  "name": "chefly_platforms",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "add:web": "pnpm dlx shadcn@latest add -c apps/web",
    "add:mobile": "pnpm --filter @chefly/mobile ui:add",
    "build": "turbo build",
    "dev:web": "pnpm --filter @chefly/web dev",
    "dev:mobile": "pnpm --filter @chefly/mobile dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.15",
    "typescript": "~6"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
